@{
    ViewData["Title"] = "thong tin san pham";
}

<h1>@ViewData["Title"]</h1>
<hr />
<div class="alert alert-danger">
    <h2>lay tu viewbag</h2>
    <p>ID: @ViewBag.productVD.productID</p>
    <p>Name: @ViewBag.productVD.productName</p>
