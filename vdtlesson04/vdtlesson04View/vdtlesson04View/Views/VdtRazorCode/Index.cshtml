@{
	ViewData["title"] = "Razor C#";
}
<h1>ngon ngu lap trinh Razor Code </h1
<hr />
@{
	var name = "vu duy tuan";
	int age = 20;
	string email = "vuduytuan25042006@gmail.com";
}

<div class="alert alert-info">
	<h2>welcome to @name</h2>
	<p>age: @age</p>
	<p>email: @email</p>
</div>

<div class="alert alert-success">
	<h2>welcome to @name</h2>
	@{
		var currentDate = DateTime.Now.DayOfWeek;
		var greetingMassage = currentDate == DayOfWeek.Monday ? "Happy Monday!" : "Have a great day!";
		
	}
	<h3>@greetingMassage</h3>
</div>

<div class="alert alert-light">
	<h2>cau truc if</h2>
	@if (age > 18)
	{
		<p>ban du tuoi tham gia</p>
	}
	else
	{
		<p>ban chua du tuoi tham gia</p>
	}
</div>
<div class="alert alert-danger">
	<h2>cau truc for</h2>
	<ul>
		@for(int i = 1; i <= 10; i++)
		{
			if (i % 2 == 0)
			{
				<button class="btn btn-danger">@i</button>
			}
			else
			{
				<button class="btn btn-success">@i</button>
			}
		}
	</ul> 
</div>
@{
string[] img ={"img1.jpg","img2.png","img3.png","img4.jpg"};

}
<div class="">
	@foreach(var item in img)
	{
		<img src="/icons/@item" alt="@item" width="200px">
	}
</div>